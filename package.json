{
  "name": "all-the-spaces",
  "private": true,
  "description": "Self-hosted shared 3D spaces where real objects become portals to creations.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shooter-git/all-the-spaces.git"
  },
  "homepage": "https://github.com/shooter-git/all-the-spaces#readme",
  "bugs": "https://github.com/shooter-git/all-the-spaces/issues",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:check-ports && turbo run dev --parallel --filter='./apps/*'",
    "dev:check-ports": "node tools/check-ports.mjs",
    "dev:tailnet": "node tools/dev-tailnet.mjs",
    "dev:up": "pnpm dev:check-ports && docker compose -p ats-dev -f deploy/compose/compose.dev.yml --env-file .env up -d",
    "dev:down": "docker compose -p ats-dev -f deploy/compose/compose.dev.yml --env-file .env down",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "brand:build": "node tools/brand-build.mjs",
    "dev:setup": "node tools/dev-setup.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/gfs-didot": "5.3.0",
    "@fontsource/lxgw-wenkai-tc": "5.3.0",
    "@fontsource/nanum-brush-script": "5.3.0",
    "@fontsource/noto-nastaliq-urdu": "5.3.0",
    "@fontsource/noto-serif-hebrew": "5.3.0",
    "@fontsource/noto-serif-tamil": "5.3.0",
    "@fontsource/tiro-devanagari-sanskrit": "5.3.0",
    "@fontsource/yuji-syuku": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.0",
    "@types/node": "^24.19.1",
    "harfbuzzjs": "1.6.3",
    "opentype.js": "2.0.0",
    "playwright": "1.64.0",
    "sharp": "0.35.5",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wawoff2": "2.0.1"
  }
}
