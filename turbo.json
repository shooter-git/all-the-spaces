{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "test": {
      "env": [
        "TEST_DATABASE_URL",
        "QA_BROWSER",
        "SUPERVISOR_DOCKER_TESTS",
        "ATS_WORKBENCH_IMAGE",
        "ATS_SANDBOX_RUNTIME",
        "DOCKER_SOCKET",
        "ATS_OFFLINE",
        "ATS_ASSET_CACHE",
        "ATS_BAKE",
        "ATS_BAKE_RES",
        "ATS_BAKE_SAMPLES",
        "ATS_BLENDER"
      ],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
