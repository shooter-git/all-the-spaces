# All the Spaces — local development environment.
# Copy with `pnpm dev:setup` (fills in random secrets). Never commit .env.

# --- Host ports (loopback only). Reserved block 45000-45999. ---
ATS_PORT_HTTP=45080
ATS_PORT_HTTPS=45443
ATS_PORT_WEB=45173
ATS_PORT_SERVER=45110
ATS_PORT_REALTIME=45120
ATS_PORT_POSTGRES=45132
ATS_PORT_VALKEY=45179
ATS_PORT_S3=45190
ATS_PORT_S3_ADMIN=45191
ATS_PORT_MAIL_SMTP=45125
ATS_PORT_MAIL_UI=45126
ATS_PORT_SUPERVISOR=45140
# Voice chat (LiveKit): signalling, and the two ports audio flows on.
ATS_PORT_VOICE=45880
ATS_PORT_VOICE_TCP=45881
ATS_PORT_VOICE_UDP=45882
# Where Tailscale Serve hands phones' HTTPS to Caddy (`pnpm dev:tailnet`; loopback only).
ATS_PORT_TAILNET_APP=45084
ATS_PORT_TAILNET_PLAY=45085

# --- Hostnames (*.localhost resolves to loopback and counts as a secure context) ---
ATS_APP_HOST=app.ats.localhost
ATS_PLAY_HOST=play.ats.localhost
ATS_PUBLIC_URL=http://app.ats.localhost:45080
ATS_PLAY_URL=http://play.ats.localhost:45080

# --- Secrets (generated by `pnpm dev:setup`) ---
POSTGRES_PASSWORD=__generate__
BETTER_AUTH_SECRET=__generate__
GARAGE_RPC_SECRET=__generate_hex32__
GARAGE_ADMIN_TOKEN=__generate__
REALTIME_SECRET=__generate__
SUPERVISOR_SECRET=__generate__
EGRESS_SECRET=__generate__
LIVEKIT_API_KEY=__generate_livekit_key__
LIVEKIT_API_SECRET=__generate__
S3_ACCESS_KEY_ID=__generate_garage_key_id__
S3_SECRET_ACCESS_KEY=__generate_hex32__

# --- Storage (built-in Garage by default; any S3-compatible endpoint works) ---
S3_BUCKET=ats
S3_REGION=garage

# --- Sandboxes ---
# runc in dev. gVisor (runsc) needs a Docker daemon change; never done automatically.
ATS_SANDBOX_RUNTIME=runc
# Names and labels every container, volume and network the supervisor creates.
ATS_INSTANCE=ats-dev
ATS_WORKBENCH_IMAGE=ats-workbench:dev
ATS_SANDBOX_NETWORK=ats-dev_sandbox
ATS_EGRESS_CONTAINER=ats-dev-egress-1
ATS_SUPERVISOR_URL=http://127.0.0.1:45140
# Lighting bakes, one container per room: CPUs for each (default 2), and how many run at once
# across every build (default: the host's CPUs / ATS_BAKE_CPUS). See docs/self-hosting.md.
# ATS_BAKE_CPUS=2
# ATS_BAKE_PARALLEL=4
# Checking a creation before it's published (building it, then playing it in a browser that draws
# on the CPU): CPUs for that step (default 4, or the host's CPUs if fewer).
# ATS_CHECK_CPUS=4
